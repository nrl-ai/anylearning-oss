root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true

[*.{py,pyi}]
indent_size = 4
indent_style = space

[*.{css,html,js,json,jsx,md,mdx,mjs,ts,tsx,yaml,yml}]
indent_size = 2
indent_style = space

[Makefile]
indent_style = tab

[*.md]
trim_trailing_whitespace = false
