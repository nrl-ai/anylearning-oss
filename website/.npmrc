enable-pre-post-scripts=true

# Cloudflare Pages builds with `npx @cloudflare/next-on-pages@1`, and npm cannot
# resolve that tree unaided: next-on-pages@1.13.x peer-depends on
# @cloudflare/workers-types@^4 while the wrangler@4.x it also pulls in wants ^5.
# The result is an ERESOLVE that fails the deploy before Next is even invoked.
# Both are peerOptional and next-on-pages runs fine with either, so accept the
# older resolution rather than blocking every deploy on upstream's version skew.
legacy-peer-deps=true
