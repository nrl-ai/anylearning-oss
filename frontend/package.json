{
    "name": "anylearning-frontend",
    "version": "1.0.0",
    "private": true,
    "packageManager": "pnpm@11.21.0",
    "engines": {
        "node": ">=20.9.0"
    },
    "author": {
        "name": "NRL.ai",
        "url": "https://www.nrl.ai"
    },
    "scripts": {
        "dev": "next dev -p 3021",
        "build": "next build --webpack",
        "start": "next start",
        "lint": "oxlint . -D correctness -A no-unused-vars -A no-unused-expressions",
        "lint:fix": "pnpm lint --fix",
        "prettify": "prettier './**/*.{js,jsx,ts,tsx,css,md,json,yml,yaml,html}' --config ./.prettierrc.js",
        "format": "pnpm prettify --check",
        "format:fix": "pnpm prettify --write",
        "test": "jest --runInBand",
        "typecheck": "tsc --noEmit"
    },
    "lint-staged": {
        "**/*": [
            "pnpm prettify --write --ignore-unknown"
        ],
        "*.{js,jsx,ts,tsx}": "oxlint --fix"
    },
    "dependencies": {
        "@dnd-kit/core": "6.3.1",
        "@dnd-kit/modifiers": "9.0.0",
        "@dnd-kit/sortable": "10.0.0",
        "@dnd-kit/utilities": "3.2.2",
        "@hookform/resolvers": "5.8.0",
        "@radix-ui/react-icons": "1.3.2",
        "@svgdotjs/svg.js": "3.2.8",
        "@tanstack/react-query": "5.101.4",
        "@tanstack/react-table": "9.1.2",
        "axios": "1.19.0",
        "canvas": "3.2.3",
        "class-variance-authority": "0.7.1",
        "clsx": "2.1.1",
        "cmdk": "1.1.1",
        "date-fns": "4.4.0",
        "framer-motion": "13.1.0",
        "lucide-react": "1.31.0",
        "match-sorter": "8.3.0",
        "next": "16.3.1",
        "next-themes": "0.4.6",
        "nextjs-toploader": "3.9.17",
        "nuqs": "2.9.5",
        "radix-ui": "1.6.7",
        "react": "19.2.8",
        "react-day-picker": "10.0.1",
        "react-dom": "19.2.8",
        "react-dropzone": "20.1.0",
        "react-hook-form": "7.85.0",
        "react-konva": "19.2.5",
        "react-responsive": "10.0.1",
        "react-zoom-pan-pinch": "4.0.4",
        "recharts": "3.10.1",
        "sharp": "0.35.3",
        "sonner": "2.0.8",
        "tailwind-merge": "3.6.0",
        "tiny-invariant": "1.3.3",
        "use-debounce": "10.1.1",
        "zod": "4.4.3",
        "zustand": "5.0.15"
    },
    "devDependencies": {
        "@faker-js/faker": "10.6.0",
        "@svgr/webpack": "8.1.0",
        "@tailwindcss/postcss": "4.3.3",
        "@tanstack/react-query-devtools": "5.101.4",
        "@testing-library/jest-dom": "7.0.1",
        "@testing-library/react": "16.3.2",
        "@testing-library/user-event": "14.6.4",
        "@trivago/prettier-plugin-sort-imports": "6.0.2",
        "@types/jest": "30.0.0",
        "@types/node": "26.2.0",
        "@types/react": "19.2.18",
        "@types/react-dom": "19.2.4",
        "jest": "30.4.2",
        "jest-environment-jsdom": "30.4.1",
        "lint-staged": "17.3.0",
        "oxlint": "1.78.0",
        "postcss": "8.5.26",
        "prettier": "3.9.6",
        "prettier-plugin-tailwindcss": "0.8.1",
        "react-svgdotjs": "2.1.1",
        "tailwindcss": "4.3.3",
        "tw-animate-css": "1.4.0",
        "typescript": "7.0.2"
    }
}
