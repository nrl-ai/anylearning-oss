# Generated by next-sitemap during the website build
website/public/sitemap*.xml
# Pretrained weights, fetched by fetch_weights.py before a build. About 1.7 GB;
# they are a build input, not source.
/weights/
# Release artefacts, which get downloaded here from the build machines to be
# uploaded. Several gigabytes each; they belong in the bucket, not in git.
AnyLearning-*.tar.gz
AnyLearning-*.dmg
AnyLearning-*.zip
AnyLearning-*.exe

# Written by build_app.sh to distinguish a packaged build from a checkout and
# removed by its EXIT trap.
/anylearning/build_stamp.py

# Agent worktrees. `git worktree` puts its administrative files in .git, but the
# checkouts themselves land here, and committing one would add a second copy of
# the whole tree.
/.claude/worktrees/
.vercel/
.env.local

# Local real-model validation artifacts (JSON, timings, and annotated images).
/validation-results/
/tests/fixtures/inference/real_models/*.onnx
/tests/fixtures/inference/real_models/*.jpg
/tests/fixtures/inference/real_models/*.png
/tests/fixtures/inference/real_models/*_external/
